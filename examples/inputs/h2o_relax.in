&CONTROL
  calculation   = 'relax'
  prefix        = 'h2o'
  outdir        = './tmp_h2o'
  pseudo_dir    = './pseudo'
  forc_conv_thr = 1.0d-3
/
&SYSTEM
  ibrav     = 1
  celldm(1) = 15.1178
  nat       = 3
  ntyp      = 2
  ecutwfc   = 25.0
  ecutrho   = 200.0
/
&ELECTRONS
  conv_thr = 1.0d-8
/
&IONS
/
ATOMIC_SPECIES
  O   15.999  O.pz-rrkjus.UPF
  H    1.008  H.pz-vbc.UPF
ATOMIC_POSITIONS angstrom
  O   4.000  4.000  4.120
  H   4.819  4.000  3.546
  H   3.181  4.000  3.546
K_POINTS gamma
