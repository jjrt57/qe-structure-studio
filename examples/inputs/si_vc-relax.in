&CONTROL
  calculation   = 'vc-relax'
  prefix        = 'si'
  outdir        = './tmp_si'
  pseudo_dir    = './pseudo'
  forc_conv_thr = 1.0d-4
/
&SYSTEM
  ibrav     = 2
  celldm(1) = 9.90
  nat       = 2
  ntyp      = 1
