&CONTROL
  calculation   = 'vc-relax'
  prefix        = 'tio2'
  outdir        = './tmp_tio2'
  pseudo_dir    = './pseudo'
  forc_conv_thr = 1.0d-3
  etot_conv_thr = 1.0d-5
/
&SYSTEM
  ibrav     = 0
  nat       = 6
  ntyp      = 2
  ecutwfc   = 25.0
  ecutrho   = 200.0
/
