! Wurtzite ZnO at the experimental lattice: a = 3.2495 Å, c = 5.2069 Å, u = 0.3819
&CONTROL
  calculation = 'scf'
  prefix      = 'zno'
  pseudo_dir  = './pseudo'
  outdir      = './tmp'
/
&SYSTEM
  ibrav     = 4
  celldm(1) = 6.140665
  celldm(3) = 1.602370
